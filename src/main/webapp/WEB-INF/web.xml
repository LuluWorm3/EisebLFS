<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

  <display-name>Eiseb Livestock Financial System</display-name>

  <context-param>
    <param-name>db.driver</param-name>
    <param-value>com.mysql.cj.jdbc.Driver</param-value>
  </context-param>
  <context-param>
    <param-name>db.url</param-name>
    <param-value>jdbc:mysql://localhost:3306/eiseb_lfs?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true</param-value>
  </context-param>
  <context-param>
    <param-name>db.user</param-name>
    <param-value>eiseb_user</param-value>
  </context-param>
  <context-param>
    <param-name>db.password</param-name>
    <param-value>Eiseb123@#</param-value>
  </context-param>

  <session-config>
    <session-timeout>60</session-timeout>
  </session-config>

  <!-- Auth -->
  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>RegisterServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.RegisterServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>RegisterServlet</servlet-name>
    <url-pattern>/register</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <!-- Livestock -->
  <servlet>
    <servlet-name>LivestockServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.LivestockServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LivestockServlet</servlet-name>
    <url-pattern>/livestock</url-pattern>
  </servlet-mapping>

  <!-- Valuations -->
  <servlet>
    <servlet-name>ValuationServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.ValuationServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ValuationServlet</servlet-name>
    <url-pattern>/valuations</url-pattern>
  </servlet-mapping>

  <!-- Sales -->
  <servlet>
    <servlet-name>SalesServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.SalesServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SalesServlet</servlet-name>
    <url-pattern>/sales</url-pattern>
  </servlet-mapping>

  <!-- Expenses -->
  <servlet>
    <servlet-name>ExpenseServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.ExpenseServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ExpenseServlet</servlet-name>
    <url-pattern>/expenses</url-pattern>
  </servlet-mapping>

  <!-- Reports -->
  <servlet>
    <servlet-name>ReportServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.ReportServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ReportServlet</servlet-name>
    <url-pattern>/reports</url-pattern>
  </servlet-mapping>

  <!-- Enquiries / Contact -->
  <servlet>
    <servlet-name>EnquiryServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.EnquiryServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>EnquiryServlet</servlet-name>
    <url-pattern>/contact</url-pattern>
  </servlet-mapping>

  <!-- Dashboard -->
  <servlet>
    <servlet-name>DashboardServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.DashboardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>DashboardServlet</servlet-name>
    <url-pattern>/dashboard</url-pattern>
  </servlet-mapping>

  <!-- Admin User Management -->
  <servlet>
    <servlet-name>AdminUsersServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.AdminUsersServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminUsersServlet</servlet-name>
    <url-pattern>/admin/users</url-pattern>
  </servlet-mapping>

  <!-- CSV Export -->
  <servlet>
    <servlet-name>ExportCSVServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.ExportCSVServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ExportCSVServlet</servlet-name>
    <url-pattern>/export</url-pattern>
  </servlet-mapping>

  <!-- Profile -->
  <servlet>
    <servlet-name>ProfileServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.ProfileServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ProfileServlet</servlet-name>
    <url-pattern>/profile</url-pattern>
  </servlet-mapping>

  <!-- Audit Log -->
  <servlet>
    <servlet-name>AdminAuditServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.AdminAuditServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminAuditServlet</servlet-name>
    <url-pattern>/admin/audit</url-pattern>
  </servlet-mapping>
  <!-- Help -->
  <servlet>
    <servlet-name>HelpServlet</servlet-name>
    <servlet-class>com.eiseb.servlet.HelpServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>HelpServlet</servlet-name>
    <url-pattern>/help</url-pattern>
  </servlet-mapping>
  <!-- Welcome -->
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- Error pages -->
  <error-page>
    <error-code>404</error-code>
    <location>/pages/error404.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/pages/error500.jsp</location>
  </error-page>
</web-app>
